{
  "clangd.arguments": [
    "--query-driver=C:/msys64/ucrt64/bin/g++.exe,C:/msys64/ucrt64/bin/gcc.exe",
    "--background-index",
    "--header-insertion=never"
  ],
  "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "code-runner.executorMap": {
    "c": "cd $dir && gcc -std=c17 $fileName -o $fileNameWithoutExt.exe && ./$fileNameWithoutExt.exe",
    "cpp": "cd $dir && g++ -std=c++17 $fileName -o $fileNameWithoutExt.exe && ./$fileNameWithoutExt.exe"
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true
}
